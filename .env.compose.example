# Copy to .env.compose and use `docker compose --env-file .env.compose up --build`.
# Local Compose defaults to development mode and HTTP. This is for disposable local use.
# For deployment, set NODE_ENV=production, use HTTPS at a trusted edge, set the public origin,
# and replace every value with unique high-entropy secrets from a secret manager.
NODE_ENV=development
PUBLIC_ORIGIN=http://localhost:8080
WEB_PORT=8080
MYSQL_PASSWORD=CHANGE-ME-LOCAL-MYSQL-PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE-ME-LOCAL-MYSQL-ROOT-PASSWORD
JWT_ACCESS_SECRET=CHANGE-ME-LOCAL-ACCESS-SECRET-0123456789abcdef
JWT_REFRESH_SECRET=CHANGE-ME-LOCAL-REFRESH-SECRET-0123456789abcdef
DEVICE_HMAC_SECRET=CHANGE-ME-LOCAL-DEVICE-SECRET-0123456789
SEED_DEMO_PASSWORD=CHANGE-ME-LOCAL-SEED-PASSWORD-0123456789
LOG_LEVEL=info
