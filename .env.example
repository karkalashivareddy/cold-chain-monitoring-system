# ---------------------------------------------------------------------------
# FROSTGUARD environment template. Copy to apps/api/.env for local development.
# NEVER commit real credentials. The values below are development-only defaults.
# ---------------------------------------------------------------------------

NODE_ENV=development
API_PORT=4000
API_ORIGIN=http://localhost:4000
WEB_ORIGIN=http://localhost:5173

# MySQL. In Docker Compose the host is the service name (mysql).
DATABASE_URL="mysql://frostguard:frostguard_dev_password@localhost:3306/frostguard"

# Authentication. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET="dev-only-access-secret-change-me-0123456789abcdef0123456789abcdef"
JWT_REFRESH_SECRET="dev-only-refresh-secret-change-me-0123456789abcdef0123456789abcdef"
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=14

# Device telemetry: HMAC shared secret used to sign simulator/device payloads.
DEVICE_HMAC_SECRET="dev-only-device-hmac-secret-change-me-0123456789abcdef"

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
LOGIN_RATE_LIMIT_MAX=10

# Observability
LOG_LEVEL=info

# Demo seed (development only)
SEED_DEMO_PASSWORD="Frostguard#2026"
